{
  "name": "discord-voice-recorder",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "ts-node src/bot.ts",
    "build": "tsc",
    "dev": "nodemon --exec ts-node src/bot.ts",
    "test:matcher": "node test/test-task-matcher.js",
    "test:clickup": "node test/test-clickup-api.js",
    "test:flow": "node test/test-full-discord-flow.js",
    "test:recording": "node test/test-voice-recording-integration.js",
    "test:real": "node test/test-real-bot-integration.js",
    "test:audio": "node test/test-with-real-audio.js",
    "test:all": "npm run test:clickup && npm run test:matcher && npm run test:flow && npm run test:recording",
    "test:real-all": "npm run test:real && npm run test:audio",
    "clean": "rm -rf recordings/*.pcm recordings/*.wav",
    "clean:all": "rm -rf recordings/* && echo '1399594930355306650' > recordings/saved_channel.txt"
  },
  "keywords": [
    "discord",
    "voice",
    "recorder",
    "transcription",
    "whisper"
  ],
  "author": "",
  "license": "ISC",
  "description": "Discord voice recorder with real-time transcription using Colab API",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.18.0",
    "axios": "^1.11.0",
    "discord.js": "^14.21.0",
    "dotenv": "^17.2.1",
    "prism-media": "^1.3.5",
    "wav": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/wav": "^1.0.4",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
